{
	"name": "wikidata-entity-reader",
	"version": "5.0.0",
	"description": "read information of wikidata entities in a simpler way",
	"keywords": [
		"entity",
		"wikibase",
		"wikidata"
	],
	"license": "MIT",
	"author": {
		"name": "EdJoPaTo",
		"email": "wikibase-npm-package@edjopato.de",
		"url": "https://edjopato.de"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/EdJoPaTo/wikidata-entity-reader.git"
	},
	"files": [
		"dist",
		"!*.test.*",
		"!test.*"
	],
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"scripts": {
		"build": "rm -rf ./dist && tsc",
		"prepack": "npm run build",
		"test": "rm -rf ./dist && tsc --noEmit && oxlint && oxfmt --check && c8 --all node --enable-source-maps --test"
	},
	"dependencies": {
		"wikibase-sdk": "^11.6.6"
	},
	"devDependencies": {
		"@types/node": "^18.18.13",
		"c8": "^12.0.0",
		"oxfmt": "^0.75.0",
		"oxlint": "^1.90.0",
		"oxlint-tsgolint": "^7.0.2005",
		"typescript": "^7.0.2"
	},
	"engines": {
		"node": ">=14"
	}
}
